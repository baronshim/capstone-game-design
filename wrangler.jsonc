{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imposter-turing",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/rooms", "/rooms/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "FEEDBACK", "class_name": "FeedbackObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["FeedbackObject"] }
  ],
  "vars": { "BOT_MODE": "fake", "ROOM_RATE_LIMIT": "5", "FEEDBACK_RATE_LIMIT": "5" },
  // The AI binding needs a Cloudflare login to reach even in `wrangler dev`, so it lives only
  // in `env.production`; local dev and the test environment never declare it.
  "env": {
    "test": {
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "RoomObject" },
          { "name": "FEEDBACK", "class_name": "FeedbackObject" }
        ]
      },
      "vars": { "BOT_MODE": "fake", "ROOM_RATE_LIMIT": "0", "FEEDBACK_RATE_LIMIT": "2", "FEEDBACK_KEY": "test-feedback-key" }
    },
    "production": {
      "name": "imposter-turing",
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "RoomObject" },
          { "name": "FEEDBACK", "class_name": "FeedbackObject" }
        ]
      },
      "ai": { "binding": "AI" },
      // FEEDBACK_KEY is a secret here: `wrangler secret put FEEDBACK_KEY --env production`.
      "vars": {
        "BOT_MODE": "live",
        "BOT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "ROOM_RATE_LIMIT": "5",
        "FEEDBACK_RATE_LIMIT": "5"
      }
    }
  }
}
