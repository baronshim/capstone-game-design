{
  "name": "imposter-turing",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:client": "esbuild src/client/app.ts --bundle --format=esm --outfile=public/app.js",
    "dev": "npm run build:client && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build:client && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
